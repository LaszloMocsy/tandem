---
// Three steps, each with a product mock built in HTML and CSS. Blue-violet
// marks what agents do, coral marks what you do.
import CodeBlock from './CodeBlock.astro';
import CopyButton from './CopyButton.astro';

const taskFile = `---
id: m2ex9rd
title: Add a --units flag
status: in_progress
priority: high
labels: [cli]
created: 2026-10-20
---

## Description
Let people pick metric or imperial output.

## Acceptance criteria
- [ ] \`--units\` accepts metric and imperial
- [ ] The default follows the system locale
- [ ] \`--help\` documents the flag

## Changelog

### 2026-10-20 · You · created

### 2026-10-21 · claude-code-4537 · started`;

const statusDiff = `- status: todo
+ status: in_progress`;

const mcpCommand = 'claude mcp add --transport http tandem http://127.0.0.1:4317/p/<project-id>/mcp';
---

<section id="how-it-works" class="how" aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title">How it works</h2>

    <ol class="steps">
      <li class="step">
        <div class="text">
          <p class="num">1</p>
          <h3>Tasks are files</h3>
          <p>
            Each task is a Markdown file in your repo's <code>.tandem/</code> folder, committed with
            the code that works on it. The file is the card: when an agent starts the task, one line
            changes.
          </p>
        </div>
        <div class="mock file-mock">
          <div class="window">
            <p class="filename">.tandem/m2ex9rd.md</p>
            <CodeBlock code={taskFile} lang="md" />
          </div>
          <div class="beside">
            <div class="column" aria-hidden="true">
              <p class="column-title">In progress <span>1</span></p>
              <div class="card">
                <p class="card-meta"><span class="dot high"></span><code>m2ex9rd</code></p>
                <p class="card-title">Add a --units flag</p>
                <p class="chips"><span class="chip">cli</span></p>
                <p class="holder agent"><span class="live"></span>claude-code-4537</p>
              </div>
            </div>
            <div class="window diff">
              <p class="filename">git diff</p>
              <CodeBlock code={statusDiff} lang="diff" />
            </div>
          </div>
        </div>
      </li>

      <li class="step">
        <div class="text">
          <p class="num agent">2</p>
          <h3>Agents use MCP</h3>
          <p>
            Tandem runs an MCP server on your machine. Add it to your agent once; it claims a task,
            logs progress and finishes it through MCP tools, safely alongside other agents.
          </p>
        </div>
        <div class="mock">
          <div class="window">
            <div class="command">
              <code><span class="prompt" aria-hidden="true">$ </span>{mcpCommand}</code>
              <CopyButton text={mcpCommand} label="the claude mcp add command" />
            </div>
          </div>
          <ol class="trace" aria-label="An agent working a task">
            <li>
              <code class="tool">start_task</code>
              <span class="arg"><code>m2ex9rd</code> → in progress</span>
            </li>
            <li>
              <code class="tool">log_progress</code>
              <span class="arg">"Parsing --units with clap"</span>
            </li>
            <li>
              <code class="tool">log_progress</code>
              <span class="arg">"Locale default done, adding tests"</span>
            </li>
            <li>
              <code class="tool">finish_task</code>
              <span class="arg">met 1, 2, 3 → Review</span>
            </li>
          </ol>
        </div>
      </li>

      <li class="step">
        <div class="text">
          <p class="num human">3</p>
          <h3>You review</h3>
          <p>
            Finished work waits in Review with the agent's summary and its ticked criteria. Mark it
            reviewed, or reopen it with feedback for the next attempt. Only you can tick it off.
          </p>
        </div>
        <div
          class="mock"
          role="img"
          aria-label="A task in the Review column, waiting for your review, with Mark reviewed and Reopen with feedback buttons."
        >
          <div class="review">
            <p class="column-title">Review <span>1</span></p>
            <div class="card">
              <p class="card-meta"><span class="dot high"></span><code>m2ex9rd</code></p>
              <p class="card-title">Add a --units flag</p>
              <p class="chips"><span class="chip">cli</span></p>
            </div>
            <div class="summary">
              <p class="who agent">claude-code-4537 · finished</p>
              <p>Added --units with metric and imperial, defaulting from the locale, plus tests.</p>
              <ul class="criteria">
                <li><span class="tick">✓</span> <code>--units</code> accepts metric and imperial</li>
                <li><span class="tick">✓</span> The default follows the system locale</li>
                <li><span class="tick">✓</span> <code>--help</code> documents the flag</li>
              </ul>
            </div>
            <div class="bar">
              <p>Waiting for your review.</p>
              <div class="actions">
                <span class="btn primary">Mark reviewed</span>
                <span class="btn">Reopen with feedback</span>
              </div>
            </div>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .how {
    padding-block: clamp(56px, 10vw, 112px);
  }

  h2 {
    margin: 0 0 clamp(32px, 6vw, 56px);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.015em;
    text-align: center;
  }

  .steps {
    display: grid;
    gap: clamp(48px, 9vw, 96px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    gap: 24px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .step {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
    }
  }

  .text h3 {
    margin: 8px 0 10px;
    font-size: 1.35rem;
  }

  .text p {
    margin: 0;
    color: var(--muted);
  }

  .text code {
    color: var(--text);
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin: 0;
    border-radius: 50%;
    background: var(--chip);
    color: var(--text) !important;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .num.agent {
    background: var(--agent);
    color: #fff !important;
  }

  .num.human {
    background: var(--human);
    color: #1c2026 !important;
  }

  /* Mocks */

  .mock {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .window {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .filename {
    margin: 0;
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .file-mock {
    align-items: start;
  }

  .beside {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  @media (min-width: 560px) {
    .file-mock {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }

  .column,
  .review {
    padding: 10px;
    border-radius: var(--radius);
    background: var(--column);
  }

  .column-title {
    margin: 2px 4px 10px;
    font-weight: 650;
    font-size: 0.85rem;
  }

  .column-title span {
    margin-left: 4px;
    color: var(--muted);
    font-weight: 400;
  }

  .card {
    display: grid;
    gap: 6px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .card p {
    margin: 0;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot.high {
    background: #d64545;
  }

  .card-title {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .chip {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--chip);
    color: var(--muted);
    font-size: 0.72rem;
  }

  .holder {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
    padding: 1px 8px 1px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .agent {
    color: var(--agent-ink);
  }

  .holder.agent {
    background: color-mix(in srgb, var(--agent-to) 14%, transparent);
  }

  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2f9e5b;
  }

  /* Step 2 */

  .command {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
  }

  .command code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .prompt {
    color: var(--muted);
    user-select: none;
  }

  .trace {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trace li {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: 4px 14px;
    align-items: baseline;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--agent-to);
    border-radius: 8px;
    background: var(--surface);
    font-size: 0.85rem;
  }

  .tool {
    color: var(--agent-ink);
    font-weight: 600;
  }

  .arg {
    min-width: 0;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 420px) {
    .trace li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Step 3 */

  .review {
    display: grid;
    gap: 10px;
  }

  .summary,
  .bar {
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font-size: 0.85rem;
  }

  .summary p,
  .bar p {
    margin: 0 0 8px;
  }

  .who {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .criteria {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  .tick {
    color: #2f9e5b;
    font-weight: 700;
  }

  .bar {
    border-color: color-mix(in srgb, var(--human-to) 55%, var(--border));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .btn {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .btn.primary {
    border-color: transparent;
    background: var(--human);
    color: #1c2026;
  }
</style>
