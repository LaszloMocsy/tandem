---
import { LICENSE_URL, RELEASES_URL, REPO_URL } from '../consts';
---

<footer class="footer">
  <div class="container footer-inner">
    <p>Tandem · MIT licensed</p>
    <ul>
      <li><a href={REPO_URL}>GitHub</a></li>
      <li><a href={RELEASES_URL}>Releases</a></li>
      <li><a href={LICENSE_URL}>License</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 24px;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--muted);
  }

  a:hover {
    color: var(--text);
  }
</style>
